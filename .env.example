# Base URL of the backend API. Used by the Axios instance at runtime and by
# next.config.ts to derive the CSP `connect-src` at build time.
#
# Set an ABSOLUTE URL. next.config.ts only *throws* for a value it cannot parse
# at all (e.g. `api/v1`); it fails closed rather than loudly for the rest. Left
# empty it short-circuits, and a scheme-less value like `localhost:8000/api/v1`
# parses to the origin "null" — both build cleanly and then block every API call
# at runtime, because connect-src never gains the host you meant.
# The default points at the in-repo mock auth backend (src/app/api/v1), which
# speaks the authentication_flow.md contract. Point it at http://localhost:8000/api/v1
# to run against the real elogbook-backend instead. Either way, changing this
# needs a REBUILD, not just a restart.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Comma-separated hosts allowed to serve optimized images (next/image).
NEXT_PUBLIC_IMAGE_HOSTS=localhost

# Playwright target. Only needed when running e2e against a deployed build.
PLAYWRIGHT_BASE_URL=http://localhost:3000
